{
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/runeprofile-proxy?resource=leaderboard-refresh",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/wom-proxy?type=goal-reconcile",
      "schedule": "0 4 * * *"
    }
  ]
}
